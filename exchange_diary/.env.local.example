# 日記の投稿で使用されるSupabase接続
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# 1日1つの共有質問を作成するために使用される、サーバー専用のキーです。実際の値を（ソースコードなどに）コミットしないでください。
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Inference Providers の権限を持つ Hugging Face トークン。実際の値をコミットしないでください。
HUGGINGFACE_API_KEY=hf_replace_me
HUGGINGFACE_MODEL=openai/gpt-oss-20b:cheapest
